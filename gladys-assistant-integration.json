{
  "manifest_version": 1,
  "type": "device",
  "name": "serveur api",
  "description": {
    "en": "Link Gladys with a nodejs server: works with HTTP API...",
    "fr": "Reliez Gladys à un serveur nodejs :fonctionne avec http api ..."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/mgrafr/serveur-api:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/mgrafr/serveur-api/main/cover.jpg",
  "categories": ["services", "network"],
  "transports": ["local"],
  "containers": [
    {
      "name": "server-api",
      "docker_image": "ghcr.io/mgrafr/server-api:1.0.0",
      "ports": [
        {
          "container_port": 3002,
          "name": "http",
          "label": {
            "en": "HTTP traffic",
            "fr": "Trafic HTTP"
          }
        }
      ]
    }
  ],
  "contact_schema": [
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "SERVER-API identifier",
        "fr": "Identifiant SERVER-API"
      },
      "description": {
        "en": "Your server-api account identifier (the 8-digit login ).",
        "fr": "Votre identifiant server-api (un login à 8 chiffes ou caractères)."
      },
      "required": true
    },
    {
      "key": "access_pass,
      "type": "secret",
      "label": {
        "en": "server-api API key",
        "fr": "Clé d'API server-api"
      },
      "description": {
        "en": "The API key ",
        "fr": "La clé d'API."
      },
      "required": true
    }
  ],
  "config_schema": [
   {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Serveur api connection" ,
        "fr": "Connexion au serveur api"
      },
   "description": {
        "en": "Works from Gladys with the 'make an HTTP request' action. The URL is the server root, e.g., http://localhost:3002 or http://192.168.1.10:3002.",
        "fr": "Fonctionne depuis Gladys avec l'action 'faire une requète HTTP'. L'URL est la racine du serveur, ex. http://localhost :3002 ou http://192.168.1.10:3002."
      }
   }, 
   {
      "key": "server_url",
      "type": "string",
      "label": {
        "en": "Server URL",
        "fr": "URL du serveur"
      },
      "description": {
        "en": "For example: http://localhost;3002/backup",
        "fr": "Par exemple : http://localhost:3002/backup"
      },
     "required": true
    }    
  ],
     "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 30
    }
  ],
   "widgets": [
    {
      "key": "ln_backup_db",
      "label": {
        "en": "database backup link",
        "fr": "lien de sauvegarde database"
      },
      "description": {
        "en": "HTTP link to retrieve the database backup from a browser.",
        "fr": "lien http pour récupérer la sauvegarde des Bases de données depuis un navigateur."
      },
      "icon": "hard-drive"
    }
   ]
}
